# Dependencies
node_modules/

# Expo
.expo/
dist/
web-build/
local-builds/
expo-env.d.ts

# Native builds
android/
ios/

# Firebase — client-identifying but still kept out of git; supplied locally and
# via secrets for CI. Wildcarded, not exact filenames, so a renamed copy such as
# "google-services (customer-app).json" is still ignored.
google-services*.json
GoogleService-Info*.plist
*firebase*adminsdk*.json
serviceAccountKey*.json

# Environment variables. Both dotted (.env.prod) and undotted (env.prod) forms
# are covered, since a missing leading dot is an easy typo. The example file
# stays tracked.
.env
.env.local
.env.*.local
.env.*
!.env.example
env
env.*
*.env

# Android/iOS signing material. Never belongs in git regardless of where it's
# created or what it's named — these are the private keys that sign what ships
# to users' devices and the Play/App Store.
*.jks
*.keystore
*.p12
*.p8
*.pem
*.key
*.cer
*.mobileprovision

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp
*.swo

# TypeScript
*.tsbuildinfo

bug-reports/

/scripts/__pycache__