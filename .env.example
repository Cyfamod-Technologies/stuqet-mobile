# Copy to .env.local and fill in per environment.

# Which app this build targets: "customer" | "vendor".
# Controls the Expo Router root (src/routes/<route>), bundle id, name and scheme
# — see app.config.ts. Normally set per-command via the npm scripts
# (dev:customer / dev:vendor) rather than here; only set it in .env.local if you
# want a fixed default for `npm run dev` / `npm start`. Defaults to "customer".
# EXPO_PUBLIC_ROUTE=customer

# Base URL of your backend API (used by src/lib/config/axios.ts)
EXPO_PUBLIC_API_BASE_URL=

# Value of the backend's app.system_key. Sent as the `System-Key` header on
# every request; the API answers "Request not found!" without it.
EXPO_PUBLIC_SYSTEM_KEY=

# Sentry — the customer and vendor apps are separate Sentry projects, so each
# has its own DSN. app.config.ts picks the one matching EXPO_PUBLIC_ROUTE. Leave
# empty in development (Sentry only sends in preview/production builds).
EXPO_PUBLIC_SENTRY_DSN_CUSTOMER=
EXPO_PUBLIC_SENTRY_DSN_VENDOR=

# Sentry source map upload (build-time only, never shipped in the bundle).
# Without these, crashes still report but every stack frame stays minified.
# SENTRY_ORG is the org slug; the project slugs are the two Sentry projects the
# DSNs above belong to.
SENTRY_ORG=
SENTRY_PROJECT_CUSTOMER=
SENTRY_PROJECT_VENDOR=
# Org auth token from Sentry → Settings → Auth Tokens. Keep it out of git; for
# CI store it as a GitHub Actions secret (see docs/setup.md).
SENTRY_AUTH_TOKEN=

# Show the light/dark theme switch. Set to "false" to hide it and lock the theme.
EXPO_PUBLIC_ENABLE_THEME_SWITCH=true

# Show the Google / Apple sign-in buttons on the login screen. Set to "false" to hide them.
EXPO_PUBLIC_ENABLE_SOCIAL_LOGIN=true

# EAS — one project per app. Run `eas init` once per app (with
# EXPO_PUBLIC_ROUTE set to that app) and paste each id here. Build-time only.
# Not needed if builds go through the GitHub workflows (docs/local-builds.md).
# EAS_PROJECT_ID_CUSTOMER=
# EAS_PROJECT_ID_VENDOR=
# EAS_OWNER=
